# ASP.NET Core reads environment variables; this file is not loaded automatically by dotnet run.
# Keep the existing local connection. Configure passwords with user-secrets or your shell.
ConnectionStrings__DefaultConnection=server=localhost;database=brasfootdb;user=root;password=;
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5063
# Optional. Leave empty for runtime AutoDetect; use the actual server version when set.
# MariaDB example: 10.11.0-mariadb
Database__ServerVersion=
Cors__AllowedOrigins__0=http://localhost:5173
Cors__AllowedOrigins__1=http://localhost:4173
# Frontend variables belong in frontend/.env.local; never put passwords in VITE_*.
VITE_API_URL=http://localhost:5063
